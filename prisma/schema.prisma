generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Search {
  id                  Int      @id @default(autoincrement())
  name                String
  country             String
  region              String?
  city                String?
  language            String?
  industry            String
  service_offered     String
  target_client_type  String?
  ideal_client_signals String
  exclude_signals     String
  desired_public_data String
  max_results         Int?
  output_format       String   @default("table")
  status              String   @default("draft")
  notes               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  leads               Lead[]
}

model Lead {
  id                       Int      @id @default(autoincrement())
  search_id                Int?
  search                   Search?  @relation(fields: [search_id], references: [id], onDelete: SetNull)
  company_name             String
  country                  String?
  region                   String?
  city                     String?
  industry                 String?
  business_category        String?
  website                  String?
  contact_page             String?
  public_email             String?
  public_phone             String?
  linkedin_company_page    String?
  social_profiles          String
  company_description      String?
  score                    Int      @default(0)
  fit_grade                String   @default("C")
  contactability_score     Int      @default(0)
  confidence_score         Int      @default(0)
  reason_for_fit           String
  visible_opportunities    String
  suggested_offer          String?
  suggested_outreach_angle String?
  sources                  String
  score_explanation        String
  status                   String   @default("new")
  notes                    String   @default("")
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
  outreach_drafts          OutreachDraft[]
  source_records           Source[]

  @@index([search_id])
  @@index([status])
  @@index([score])
}

model OutreachDraft {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  channel    String
  subject    String?
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Source {
  id            Int      @id @default(autoincrement())
  lead_id       Int
  lead          Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  url           String
  source_type   String
  title         String?
  snippet       String?
  discovered_at DateTime @default(now())
}
