{
  "sources": [
    {
      "id": "osm-overpass",
      "name": "OpenStreetMap Overpass API",
      "kind": "api",
      "enabled": true,
      "countries": ["*"],
      "categories": ["*"],
      "free": true,
      "note": "Free, no key required. Global coverage for physical businesses. Attribution: © OpenStreetMap contributors (ODbL)."
    },
    {
      "id": "google-places",
      "name": "Google Places API",
      "kind": "api",
      "enabled": true,
      "countries": ["*"],
      "categories": ["*"],
      "free": false,
      "requiresKey": "GOOGLE_PLACES_API_KEY",
      "note": "Requires GOOGLE_PLACES_API_KEY in .env. Best coverage for physical retail and services worldwide."
    },
    {
      "id": "template-directory-es",
      "name": "Páginas Amarillas Spain — TEMPLATE",
      "kind": "browser",
      "enabled": false,
      "countries": ["ES"],
      "categories": ["*"],
      "free": true,
      "note": "DISABLED — template only. Before enabling, verify this site's robots.txt and Terms of Service permit automated pagination. Update selectors to match the current site structure.",
      "playwright": {
        "entryUrl": "https://www.paginasamarillas.es/buscar/{KEYWORD}/todo-espana/",
        "paginationType": "query-param",
        "paginationParam": "npag",
        "selectors": {
          "item": ".list-item-adv",
          "name": ".title-adv",
          "address": ".address",
          "phone": ".phone",
          "website": ".web a"
        },
        "stopCondition": "empty-page",
        "maxPages": 50,
        "delayMs": 2000
      }
    },
    {
      "id": "template-directory-de",
