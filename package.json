    "leads": "tsx scripts/leads.ts",
    "export": "tsx scripts/export.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
